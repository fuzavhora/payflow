generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum PaymentIntentStatus {
  REQUIRES_PAYMENT_METHOD
  REQUIRES_CONFIRMATION
  PROCESSING
  SUCCEEDED
  CANCELED
  FAILED
}
enum PaymentAttemptStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
}
enum OutboxEventStatus {
  PENDING
  PROCESSING
  PUBLISHED
  DEAD_LETTER
}
enum ApiKeyEnvironment {
  TEST
  LIVE
}
model Merchant {
  id String @id @default(cuid())
  name String
  slug String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  customers Customer[]
  paymentIntents PaymentIntent[]
  idempotencyKeys IdempotencyRecord[]
  apiKeys ApiKey[]
  outboxEvents OutboxEvent[]
  webhookEndpoints WebhookEndpoint[]
  webhookDeliveries WebhookDelivery[]
}
model ApiKey {
  id String @id @default(cuid())
  merchantId String
  name String
  keyPrefix String @unique
  keyHash String @unique
  environment ApiKeyEnvironment @default(TEST)
  scopes String[] @default([])
  lastUsedAt DateTime?
  expiresAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  @@index([merchantId, environment, revokedAt])
}
model Customer {
  id String @id @default(cuid())
  merchantId String
  email String
  name String?
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  payments PaymentIntent[]
  @@unique([merchantId, email])
  @@unique([merchantId, id])
  @@index([merchantId, createdAt])
}
model PaymentIntent {
  id String @id @default(cuid())
  merchantId String
  customerId String?
  amount BigInt
  currency String @db.Char(3)
  status PaymentIntentStatus @default(REQUIRES_PAYMENT_METHOD)
  description String?
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  customer Customer? @relation(fields: [merchantId, customerId], references: [merchantId, id], onDelete: Restrict)
  attempts PaymentAttempt[]
  @@index([merchantId, status, createdAt])
  @@index([merchantId, customerId, createdAt])
}
model PaymentAttempt {
  id String @id @default(cuid())
  paymentIntentId String
  provider String
  providerReference String?
  status PaymentAttemptStatus @default(CREATED)
  failureCode String?
  failureMessage String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  paymentIntent PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
  @@unique([provider, providerReference])
  @@index([paymentIntentId, createdAt])
}
model IdempotencyRecord {
  id String @id @default(cuid())
  merchantId String
  key String
  requestHash String
  responseStatus Int?
  responseBody Json?
  createdAt DateTime @default(now())
  expiresAt DateTime?
  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  @@unique([merchantId, key])
  @@index([expiresAt])
}

model OutboxEvent {
  id String @id @default(cuid())
  merchantId String
  eventType String
  aggregateType String
  aggregateId String
  dedupeKey String
  payload Json
  status OutboxEventStatus @default(PENDING)
  attempts Int @default(0)
  availableAt DateTime @default(now())
  lockedAt DateTime?
  lockToken String?
  publishedAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  webhookDeliveries WebhookDelivery[]
  @@unique([merchantId, dedupeKey])
  @@index([status, availableAt])
  @@index([merchantId, createdAt])
}

model WebhookEndpoint {
  id String @id @default(cuid())
  merchantId String
  url String
  enabled Boolean @default(true)
  events String[] @default([])
  secretCiphertext String
  secretIv String
  secretAuthTag String
  secretKeyVersion Int @default(1)
  previousSecretCiphertext String?
  previousSecretIv String?
  previousSecretAuthTag String?
  previousSecretKeyVersion Int?
  previousSecretExpiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  @@index([merchantId, enabled, createdAt])
  deliveries WebhookDelivery[]
}

enum WebhookDeliveryStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  DEAD_LETTER
}

model WebhookDelivery {
  id String @id @default(cuid())
  merchantId String
  endpointId String
  outboxEventId String
  status WebhookDeliveryStatus @default(PENDING)
  attempts Int @default(0)
  attemptsInCycle Int @default(0)
  nextAttemptAt DateTime @default(now())
  lockedAt DateTime?
  lockToken String?
  lastStatusCode Int?
  lastError String?
  deliveredAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  outboxEvent OutboxEvent @relation(fields: [outboxEventId], references: [id], onDelete: Cascade)
  attemptsLog WebhookDeliveryAttempt[]
  @@unique([endpointId, outboxEventId])
  @@index([status, nextAttemptAt])
  @@index([merchantId, createdAt])
}

model WebhookDeliveryAttempt {
  id String @id @default(cuid())
  deliveryId String
  attemptNumber Int
  startedAt DateTime @default(now())
  completedAt DateTime?
  statusCode Int?
  errorCode String?
  errorMessage String?
  durationMs Int?
  delivery WebhookDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  @@unique([deliveryId, attemptNumber])
  @@index([deliveryId, startedAt])
}
